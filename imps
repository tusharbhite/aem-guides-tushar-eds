        // --- Main Execution Block ---

        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('movie-details-container');

            if (!movie) {
                container.innerHTML = `<div class="p-8 text-center text-red-400 text-lg">Error: No movie data found in the JSON array.</div>`;
                return;
            }

            // Generate the dynamic HTML
            const movieHtml = generateMovieHtml(movie);

            // Dynamically insert the generated HTML into the container
            container.innerHTML = movieHtml;
        });

    </script>
</body>
