                                        <dd class="w-2/3">${m.music_composer}</dd>
                                    </div>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <!-- Production Info -->
                    <div class="bg-secondary p-6 md:p-8 rounded-xl shadow-lg">
