                        <div class="mt-4 grid md:grid-cols-2 gap-8 text-text-light">
                            
                            <!-- Cast Column -->
                            <div>
                                <h3 class="text-xl font-semibold mb-3 text-accent">Top Cast</h3>
                                <p class="text-text-muted">${mainCast}</p>
                            </div>

                            <!-- Crew Column -->
                            <div>
                                <h3 class="text-xl font-semibold mb-3 text-accent">Key Crew</h3>
                                <dl class="space-y-2 text-text-muted">
                                    <div class="flex">
                                        <dt class="w-1/3 font-medium text-text-light">Director</dt>
                                        <dd class="w-2/3">${m.director}</dd>
                                    </div>
                                    <div class="flex">
                                        <dt class="w-1/3 font-medium text-text-light">Writers</dt>
                                        <dd class="w-2/3">${limitList(m.writers, 2)}</dd>
                                    </div>
                                    <div class="flex">
                                        <dt class="w-1/3 font-medium text-text-light">Producers</dt>
                                        <dd class="w-2/3">${limitList(m.producers, 3)}</dd>
                                    </div>
                                    <div class="flex">
