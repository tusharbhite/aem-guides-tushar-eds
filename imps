                        <dl class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4 text-text-muted">
                            
                            <div class="flex">
                                <dt class="w-2/5 font-medium text-text-light">Original Title</dt>
                                <dd class="w-3/5">${m.original_title}</dd>
