                                <dd class="w-3/5">
                                    <a href="https://www.imdb.com/title/${m.imdb_id}/" target="_blank" class="text-accent hover:text-accent/80 transition">${m.imdb_id}</a>
                                </dd>
                            </div>
                        </dl>
